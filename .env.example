# .env.example
BOT_TOKEN=your_telegram_bot_token_here
API_ID=your_telegram_api_id (optional, for Telethon if needed)
API_HASH=your_telegram_api_hash (optional)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority
DB_NAME=telegram_filter_bot
ADMIN_IDS=123456789 987654321 (space-separated list of admin user IDs)
FILE_CHANNELS=-1001234567890 -1009876543210 (space-separated list of channel IDs where files are posted)
LOG_CHANNEL=-1001122334455 (optional, channel ID for logs)